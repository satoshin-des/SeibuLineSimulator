screen 0, 768, 432
title "西武線シミュレータ"

#define FINAL_STATION "西武秩父"

*main
	redraw 0
	color 255, 255, 255: boxf

	// 上のぼやぼやっとしてるやつ
	color 213, 213, 213
	boxf 0, 0, 768, 48

	// 各駅停車のやつ
	color 168, 168, 168
	boxf 5, 5, 100, 48
	font "ＭＳ ゴシック", 35, 1
	pos 15, 10: color 255, 255, 255
	mes "各停"

	// 行き先表示
	font "ＭＳ ゴシック", 35, 1
	pos 110, 10: color 129, 129, 129
	mes strf("%s ゆき", FINAL_STATION)

	// 次の駅
	font "ＭＳ ゴシック", 40, 1
	pos 15, 100: color 0, 0, 0
	mes "つぎは"
	color 49, 153, 214
	boxf 160, 67, 230, 137
	color 255, 255, 255
	boxf 167, 97, 223, 130
	font "ＭＳ ゴシック", 30, 1
	pos 179, 67: color 0, 0, 0
	mes "SX"
	font "ＭＳ ゴシック", 30, 1
	pos 179, 100: color 0, 0, 0
	mes "57"
	
	redraw 1
	await 16
	goto *main
